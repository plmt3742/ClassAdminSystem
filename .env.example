# ============================================
# 环境变量示例 —— 复制为 .env.local 并填入真实值
# ============================================

# NextAuth JWT 签名密钥（必填，生成方式：openssl rand -base64 32）
# ⚠️ 生产环境务必使用强随机值，切勿使用示例密钥
AUTH_SECRET=please-generate-a-random-secret

# 允许非 localhost 的请求（部署到服务器时必填 true）
AUTH_TRUST_HOST=true

# 部署后的公网地址（登录/退出回调使用，如 https://your-domain.com）
AUTH_URL=http://localhost:3001
